server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /admin {
        return 301 /admin/;
    }

    # Admin SPA mounted at /admin/
    location /admin/ {
        alias /usr/share/nginx/html/admin/;
        try_files $uri $uri/ /admin/index.html;
    }

    # Public web SPA at /
    location / {
        try_files $uri /index.html;
    }

    # API → separately running backend
    location /api/ {
        # Re-resolve the backend's address every 10s instead of once at
        # startup, so a backend redeploy (new internal IP) doesn't require
        # restarting this gateway to pick it up. NGINX_LOCAL_RESOLVERS comes
        # from the base image's own docker-entrypoint.d/15-local-resolvers.envsh
        # (enabled via NGINX_ENTRYPOINT_LOCAL_RESOLVERS in the Dockerfile).
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        # No URI part on proxy_pass: with a variable, nginx would send that
        # URI verbatim (every request becomes "/api/") instead of swapping
        # the location prefix. Without one, the original /api/... path and
        # query string pass through unchanged, which is what the backend
        # mounts on.
        set $backend_upstream ${BACKEND_UPSTREAM_URL};
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;

        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;

        set $forwarded_proto $http_x_forwarded_proto;
        if ($forwarded_proto = "") { set $forwarded_proto $scheme; }
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
}